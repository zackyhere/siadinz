---
import { Bell, CodeXml, House, LogOut, Menu, Moon, Send, Settings, Sun, UserRound, X } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="container">
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('siadinz-theme');
				const theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.currentScript.parentElement.setAttribute('data-theme', theme);
			} catch {
				document.currentScript.parentElement.setAttribute('data-theme', window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			}
		</script>
		<aside class="sidebar" id="sidebar">
			<div class="sidebar-header"><h2>Siadinz</h2><button id="closeSidebar" aria-label="Tutup menu"><X size={24} /></button></div>
			<nav class="sidebar-nav">
				<a href="/" class="nav-item"><House size={20} />Dashboard</a>
				<a href="/notification" class="nav-item active"><Bell size={20} />Notification</a>
				<a href="/settings" class="nav-item"><Settings size={20} />Settings</a>
				<a href="#" class="nav-item"><CodeXml size={20} />API</a>
			</nav>
		</aside>
		<div class="overlay" id="overlay"></div>

		<main class="main-content">
			<header class="top-nav">
				<button class="nav-btn" id="menuBtn" aria-label="Buka menu"><Menu size={24} /></button>
				<div class="top-nav-actions">
					<button class="theme-toggle" id="themeToggle" type="button" role="switch" aria-checked="true" aria-label="Gunakan tema terang">
						<Sun class="toggle-icon toggle-icon-light" size={16} /><Moon class="toggle-icon toggle-icon-dark" size={16} /><span class="toggle-thumb"></span>
					</button>
					<div class="profile-menu"><button class="profile-btn" id="profileBtn" aria-label="Buka menu profil"><span><UserRound size={20} /></span></button><div class="profile-dropdown" id="profileDropdown"><button><LogOut size={18} />Logout</button></div></div>
				</div>
			</header>


			<form id="notificationForm" novalidate aria-label="Pengaturan notifikasi">
				<section class="settings-card reveal-on-scroll" aria-labelledby="push-title">
					<div class="card-heading"><span class="card-icon"><Bell size={20} /></span><div><h2 id="push-title">Push Notification</h2><p>Notifikasi langsung pada perangkat untuk aktivitas absensi.</p></div><button type="button" id="testNotification" class="test-btn">Test Notification</button></div>
					<div class="settings-list">
						<label class="setting-row"><span><strong>Aktifkan</strong><small>Izinkan notifikasi push dari Siadinz.</small></span><input id="pushEnabled" type="checkbox" role="switch" /></label>
						<label class="setting-row"><span><strong>Jadwal absen hari ini</strong><small>Ingatkan jika ada jadwal kuliah hari ini.</small></span><input id="pushSchedule" type="checkbox" role="switch" /></label>
						<label class="setting-row"><span><strong>Push presensi</strong><small>Kirim notifikasi jika berhasil absensi.</small></span><input id="pushAttended" type="checkbox" role="switch" /></label>
					</div>
				</section>

				<section class="settings-card reveal-on-scroll" aria-labelledby="discord-title">
					<div class="card-heading"><span class="card-icon"><Send size={20} /></span><div><h2 id="discord-title">Discord Webhook</h2><p>Kirim pengingat absensi ke channel Discord pilihan Anda.</p></div><button type="button" id="testWebhook" class="test-btn">Test Webhook</button></div>
					<div class="webhook-field"><label for="discordWebhook">Link webhook Discord</label><input id="discordWebhook" type="url" inputmode="url" autocomplete="url" placeholder="https://discord.com/api/webhooks/..." aria-describedby="webhookHint webhookError" /><p id="webhookError" class="field-error" role="alert"></p></div>
					<div class="settings-list">
						<label class="setting-row"><span><strong>Aktifkan</strong><small>Gunakan webhook Discord untuk mengirim notifikasi.</small></span><input id="discordEnabled" type="checkbox" role="switch" /></label>
						<label class="setting-row"><span><strong>Jadwal absen hari ini</strong><small>Ingatkan jika ada jadwal kuliah hari ini.</small></span><input id="discordSchedule" type="checkbox" role="switch" /></label>
						<label class="setting-row"><span><strong>Push presensi</strong><small>Kirim notifikasi jika berhasil absensi.</small></span><input id="discordAutomatic" type="checkbox" role="switch" /></label>
					</div>
				</section>
				<div class="save-status"><p id="saveStatus" role="status"></p></div>
			</form>
		</main>
	</div>

	<script>
		const container = document.querySelector<HTMLElement>('.container');
		const themeToggle = document.getElementById('themeToggle');
		const sidebar = document.getElementById('sidebar');
		const overlay = document.getElementById('overlay');
		const profileBtn = document.getElementById('profileBtn');
		const profileDropdown = document.getElementById('profileDropdown');
		const storageKey = 'siadinz-notification-settings';
		const webhookInput = document.getElementById('discordWebhook') as HTMLInputElement;
		const webhookError = document.getElementById('webhookError') as HTMLParagraphElement;
		const saveStatus = document.getElementById('saveStatus') as HTMLParagraphElement;
		const controlIds = ['pushEnabled', 'pushSchedule', 'pushAttended', 'discordEnabled', 'discordSchedule', 'discordAutomatic'] as const;
		let statusTimer: ReturnType<typeof setTimeout> | undefined;

		const showStatus = (message: string) => {
			saveStatus.textContent = message;
			if (statusTimer) clearTimeout(statusTimer);
			statusTimer = setTimeout(() => { saveStatus.textContent = ''; }, 4000);
		};
		const getTheme = () => { try { const value = localStorage.getItem('siadinz-theme'); return value === 'light' || value === 'dark' ? value : null; } catch { return null; } };
		const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
		const applyTheme = (theme: 'light' | 'dark') => { container?.setAttribute('data-theme', theme); themeToggle?.setAttribute('aria-checked', String(theme === 'dark')); themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Gunakan tema terang' : 'Gunakan tema gelap'); };
		applyTheme(getTheme() ?? (systemTheme.matches ? 'dark' : 'light'));
		themeToggle?.addEventListener('click', () => { const theme = container?.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; try { localStorage.setItem('siadinz-theme', theme); } catch {} applyTheme(theme); });
		systemTheme.addEventListener('change', (event) => { if (!getTheme()) applyTheme(event.matches ? 'dark' : 'light'); });
		document.getElementById('menuBtn')?.addEventListener('click', () => { sidebar?.classList.add('active'); overlay?.classList.add('active'); });
		const closeMenu = () => { sidebar?.classList.remove('active'); overlay?.classList.remove('active'); };
		document.getElementById('closeSidebar')?.addEventListener('click', closeMenu); overlay?.addEventListener('click', closeMenu);
		profileBtn?.addEventListener('click', () => profileDropdown?.classList.toggle('active'));
		document.addEventListener('click', (event) => { if (!profileBtn?.contains(event.target as Node)) profileDropdown?.classList.remove('active'); });

		const loadSettings = () => { try { const saved = JSON.parse(localStorage.getItem(storageKey) ?? '{}'); controlIds.forEach((id) => { const control = document.getElementById(id) as HTMLInputElement; control.checked = Boolean(saved[id]); }); webhookInput.value = typeof saved.discordWebhook === 'string' ? saved.discordWebhook : ''; } catch {} };
		const isDiscordWebhook = (value: string) => { try { const url = new URL(value); return url.protocol === 'https:' && (url.hostname === 'discord.com' || url.hostname === 'discordapp.com') && /^\/api\/webhooks\/[^/]+\/[^/]+/.test(url.pathname); } catch { return false; } };

		const persist = () => {
			const webhook = webhookInput.value.trim();
			webhookError.textContent = '';
			if (webhook && !isDiscordWebhook(webhook)) {
				webhookError.textContent = 'Masukkan URL webhook Discord yang valid.';
				showStatus('Perbaiki URL webhook agar pengaturan tersimpan.');
				return false;
			}
			const settings: Record<string, boolean | string> = { discordWebhook: webhook };
			controlIds.forEach((id) => { settings[id] = (document.getElementById(id) as HTMLInputElement).checked; });
			try {
				localStorage.setItem(storageKey, JSON.stringify(settings));
				return true;
			} catch {
				showStatus('Pengaturan diterapkan, tetapi tidak dapat disimpan di browser ini.');
				return false;
			}
		};

		const requestPushPermission = async () => {
			if (!('Notification' in window)) {
				showStatus('Browser ini tidak mendukung notifikasi.');
				return false;
			}
			if (Notification.permission === 'granted') return true;
			if (Notification.permission === 'denied') {
				showStatus('Notifikasi diblokir di pengaturan browser.');
				return false;
			}
			const result = await Notification.requestPermission();
			if (result !== 'granted') {
				showStatus('Izin notifikasi tidak diberikan.');
				return false;
			}
			return true;
		};

		loadSettings();
		controlIds.forEach((id) => {
			const control = document.getElementById(id) as HTMLInputElement;
			control.addEventListener('change', async () => {
				if (id === 'pushEnabled' && control.checked && !(await requestPushPermission())) {
					control.checked = false;
					return;
				}
				if (persist()) showStatus('Pengaturan tersimpan otomatis.');
			});
		});
		webhookInput.addEventListener('change', () => { if (persist()) showStatus('Pengaturan tersimpan otomatis.'); });

		document.getElementById('testNotification')?.addEventListener('click', async () => {
			if (!('Notification' in window)) {
				showStatus('Browser ini tidak mendukung notifikasi.');
				return;
			}
			if (Notification.permission !== 'granted') {
				const result = await Notification.requestPermission();
				if (result !== 'granted') {
					showStatus('Izin notifikasi tidak diberikan.');
					return;
				}
			}
			try {
				new Notification('Siadinz Test', {
					body: 'Notifikasi push berhasil! Pengaturan notifikasi Anda berfungsi dengan baik.',
					icon: '/favicon.svg',
					badge: '/favicon.svg',
					tag: 'siadinz-test'
				});
				showStatus('Notifikasi test berhasil dikirim.');
			} catch (error) {
				showStatus('Gagal mengirim notifikasi test.');
			}
		});

		document.getElementById('testWebhook')?.addEventListener('click', async () => {
			const webhook = webhookInput.value.trim();
			if (!webhook) {
				webhookError.textContent = 'Masukkan URL webhook Discord terlebih dahulu.';
				showStatus('URL webhook diperlukan untuk test.');
				return;
			}
			if (!isDiscordWebhook(webhook)) {
				webhookError.textContent = 'Masukkan URL webhook Discord yang valid.';
				showStatus('URL webhook tidak valid.');
				return;
			}
			webhookError.textContent = '';
			const testBtn = document.getElementById('testWebhook') as HTMLButtonElement;
			testBtn.disabled = true;
			testBtn.textContent = 'Mengirim...';
			try {
				const response = await fetch(webhook, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						content: '✅ **Siadinz Webhook Test**\n\nWebhook Discord Anda berhasil terhubung dan berfungsi dengan baik!'
					})
				});
				if (response.ok || response.status === 204) {
					showStatus('Test webhook berhasil! Cek channel Discord Anda.');
				} else {
					showStatus('Webhook gagal. Periksa kembali URL webhook Anda.');
				}
			} catch (error) {
				showStatus('Gagal menghubungi webhook. Periksa koneksi internet Anda.');
			} finally {
				testBtn.disabled = false;
				testBtn.textContent = 'Test Webhook';
			}
		});
	</script>
</Layout>

<style>
	.container { min-height: 100vh; background: #f5f7fa; color: #27272a; } .container[data-theme="dark"] { background: #0f172a; color: #f1f5f9; }
	.sidebar { position: fixed; inset: 0 auto 0 -280px; width: 280px; background: #fff; z-index: 10; box-shadow: 2px 0 12px rgba(0,0,0,.08); transition: left .25s; } .container[data-theme="dark"] .sidebar { background: #1e293b; } .sidebar.active { left: 0; } .sidebar-header { display:flex; justify-content:space-between; align-items:center; padding:20px; border-bottom:1px solid #e2e8f0; } .container[data-theme="dark"] .sidebar-header { border-color:rgba(255,255,255,.08); } .sidebar-header h2 { font-size:20px; } .sidebar-header button { width:36px; height:36px; border:0; border-radius:8px; background:#f4f4f5; color:#3f3f46; cursor:pointer; } .container[data-theme="dark"] .sidebar-header button { background:#334155; color:#f1f5f9; }
	.sidebar-nav { padding:12px; } .nav-item { display:flex; align-items:center; gap:12px; padding:14px 16px; margin-bottom:4px; border-radius:12px; color:#64748b; text-decoration:none; font-size:15px; font-weight:500; } .nav-item:hover { background:#f8fafc; } .nav-item.active { background:#27272a; color:#fff; } .container[data-theme="dark"] .nav-item { color:#94a3b8; } .container[data-theme="dark"] .nav-item:hover { background:rgba(255,255,255,.08); } .container[data-theme="dark"] .nav-item.active { background:#f4f4f5; color:#18181b; }
	.overlay { position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:9; opacity:0; pointer-events:none; transition:opacity .25s; } .overlay.active { opacity:1; pointer-events:auto; }
	.main-content { padding:20px; max-width:960px; margin:auto; } .top-nav { display:flex; justify-content:space-between; align-items:center; margin-bottom:32px; } .nav-btn,.profile-btn { width:48px; height:48px; display:grid; place-items:center; border:0; border-radius:50%; background:#fff; color:#64748b; cursor:pointer; box-shadow:0 2px 8px rgba(0,0,0,.06); } .container[data-theme="dark"] .nav-btn,.container[data-theme="dark"] .profile-btn { background:#1e293b; color:#cbd5e1; } .top-nav-actions { display:flex; gap:12px; align-items:center; position:relative; }
	.theme-toggle { position:relative; width:58px; height:32px; padding:0; border:1px solid #d4d4d8; border-radius:999px; background:#f4f4f5; cursor:pointer; } .container[data-theme="dark"] .theme-toggle { border-color:#52525b; background:#27272a; } .toggle-icon { position:absolute; top:7px; z-index:1; } .toggle-icon-light { left:8px; } .toggle-icon-dark { right:8px; } .container[data-theme="light"] .toggle-icon-light { color:#f4f4f5; } .container[data-theme="light"] .toggle-icon-dark { color:#71717a; } .container[data-theme="dark"] .toggle-icon-light { color:#a1a1aa; } .container[data-theme="dark"] .toggle-icon-dark { color:#27272a; } .toggle-thumb { position:absolute; top:3px; left:3px; width:24px; height:24px; border-radius:50%; background:#27272a; transform:translateX(26px); transition:transform .22s ease; } .container[data-theme="dark"] .toggle-thumb { background:#f4f4f5; } .container[data-theme="light"] .toggle-thumb { transform:translateX(0); }
	.profile-menu { position:relative; } .profile-btn span { width:100%; height:100%; display:grid; place-items:center; border-radius:50%; background:#27272a; color:#fff; } .container[data-theme="dark"] .profile-btn span { background:#f4f4f5; color:#18181b; } .profile-dropdown { position:absolute; top:56px; right:0; width:160px; padding:4px; border-radius:12px; background:#fff; box-shadow:0 4px 16px rgba(0,0,0,.12); opacity:0; pointer-events:none; transform:translateY(-8px); transition:.2s; } .profile-dropdown.active { opacity:1; pointer-events:auto; transform:none; } .profile-dropdown button { width:100%; display:flex; gap:10px; align-items:center; padding:12px; border:0; border-radius:8px; background:transparent; color:#dc2626; cursor:pointer; } .container[data-theme="dark"] .profile-dropdown { background:#1e293b; }
	.settings-card { margin-bottom:20px; padding:24px; border:1px solid #e4e4e7; border-radius:16px; background:#fff; box-shadow:0 2px 10px rgba(24,24,27,.04); position:relative; } .container[data-theme="dark"] .settings-card { background:#1e293b; border-color:#334155; box-shadow:none; } .card-heading { display:flex; gap:14px; align-items:flex-start; margin-bottom:20px; padding-right:140px; } .card-icon { display:grid; place-items:center; width:40px; height:40px; border-radius:12px; background:#27272a; color:#fff; flex:0 0 auto; } .container[data-theme="dark"] .card-icon { background:#f4f4f5; color:#18181b; } .card-heading h2 { margin:1px 0 4px; font-size:18px; } .card-heading p,.setting-row small,.webhook-field small { margin:0; color:#64748b; font-size:14px; line-height:1.5; } .container[data-theme="dark"] .card-heading p,.container[data-theme="dark"] .setting-row small,.container[data-theme="dark"] .webhook-field small { color:#94a3b8; }
	.test-btn { position:absolute; top:24px; right:24px; padding:8px 16px; border:1px solid #e4e4e7; border-radius:8px; background:#fff; color:#27272a; font-size:13px; font-weight:600; cursor:pointer; transition:.2s; } .test-btn:hover { background:#f8fafc; border-color:#d4d4d8; } .test-btn:active { transform:scale(.97); } .container[data-theme="dark"] .test-btn { background:#334155; border-color:#475569; color:#f1f5f9; } .container[data-theme="dark"] .test-btn:hover { background:#475569; }
	.settings-list { border-top:1px solid #e4e4e7; } .container[data-theme="dark"] .settings-list { border-color:#334155; } .setting-row { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:17px 0; border-bottom:1px solid #e4e4e7; cursor:pointer; } .container[data-theme="dark"] .setting-row { border-color:#334155; } .setting-row strong,.setting-row small { display:block; } .setting-row strong { margin-bottom:3px; font-size:15px; } input[role="switch"] { appearance:none; width:46px; height:26px; flex:0 0 auto; margin:0; border:1px solid #d4d4d8; border-radius:999px; background:#e4e4e7; cursor:pointer; transition:.2s; } input[role="switch"]::after { content:""; display:block; width:20px; height:20px; margin:2px; border-radius:50%; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.18); transition:.2s; } input[role="switch"]:checked { background:#27272a; border-color:#27272a; } input[role="switch"]:checked::after { transform:translateX(20px); } .container[data-theme="dark"] input[role="switch"] { background:#475569; border-color:#64748b; } .container[data-theme="dark"] input[role="switch"]:checked { background:#f4f4f5; border-color:#f4f4f5; } .container[data-theme="dark"] input[role="switch"]:checked::after { background:#18181b; } input:focus-visible,button:focus-visible,a:focus-visible { outline:2px solid #27272a; outline-offset:3px; } .container[data-theme="dark"] input:focus-visible,.container[data-theme="dark"] button:focus-visible,.container[data-theme="dark"] a:focus-visible { outline-color:#f4f4f5; }
	.webhook-field { margin:0 0 4px; } .webhook-field label { display:block; margin-bottom:8px; font-size:14px; font-weight:700; } .webhook-field input { width:100%; margin-bottom:6px; padding:12px 14px; border:1px solid #d4d4d8; border-radius:10px; background:#fafafa; color:#27272a; font:inherit; } .container[data-theme="dark"] .webhook-field input { border-color:#475569; background:#0f172a; color:#f1f5f9; } .field-error { min-height:20px; margin:6px 0 0; color:#dc2626; font-size:14px; }
	.save-status { padding:0 0 28px; min-height:24px; } #saveStatus { margin:0; color:#166534; font-size:14px; } .container[data-theme="dark"] #saveStatus { color:#86efac; }
	.has-scroll-reveal .reveal-on-scroll { opacity:0; transform:translateY(18px); transition:opacity 460ms ease-out,transform 460ms cubic-bezier(.22,1,.36,1); } .has-scroll-reveal .reveal-on-scroll.is-visible { opacity:1; transform:none; } @media (prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; } } @media (max-width:600px) { .main-content { padding:16px; } .settings-card { padding:18px; } }
</style>
